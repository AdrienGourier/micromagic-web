---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Página no encontrada — MICROMAGIC"
  descripcion="La página que buscaba no existe. Vuelva al inicio o escríbanos por WhatsApp."
>
  <section class="envoltorio perdido">
    <h1>Esta página ya no está</h1>
    <p>
      Puede que la quitáramos al renovar la web, o que el enlace tenga una errata.
      Desde el inicio llega a todo lo demás.
    </p>
    <p>
      <a class="volver" href="/">Ir al inicio</a>
    </p>
  </section>
</Base>

<style>
  .perdido {
    padding-top: clamp(3rem, 12vw, 8rem);
    padding-bottom: clamp(3rem, 10vw, 6rem);
  }
  .perdido h1 { max-width: 14ch; }
  .volver {
    display: inline-block;
    margin-top: 0.5rem;
    background: var(--tinta);
    color: var(--panel);
    text-decoration: none;
    padding: 0.8rem 1.4rem;
    font-variation-settings: 'wdth' 105, 'wght' 700;
    border: 2px solid var(--tinta);
  }
  .volver:hover { background: transparent; color: var(--tinta); }
</style>
